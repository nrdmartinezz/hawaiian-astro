---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import ContactBlock from '../components/blocks/ContactBlock.astro';
import { treatmentServices } from '../config/treatments';
import { patientFormActions } from '../config/patientForms';
import { pageSeo } from '../config/seo';
import { site } from '../config/site';
import FAQ from '../components/blocks/FAQ.astro';
import { getFaqsFor } from '../lib/faqs';

const hearAbout = [
  'Google',
  'Friend or family',
  'My dentist',
  'Instagram',
  'Facebook',
  'Drove by the office',
  'Insurance',
  'Other',
];
const faqs = await getFaqsFor('/appointment/');
---

<BaseLayout
  title={pageSeo.appointment.title}
  description={pageSeo.appointment.description}
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Request an Appointment', href: '/appointment/' },
  ]}
  faqs={faqs}
>
  <Hero
    eyebrow="Let’s get started"
    title="Request a complimentary consultation"
    body={`In person or virtual. Call or text ${site.business.phone}, email ${site.business.email}, or send this form and we will reach out to schedule.`}
    actions={[
      { label: `Text ${site.business.phone}`, href: `sms:${site.business.phoneHref}` },
      ...patientFormActions('secondary'),
    ]}
  />

  <ContactBlock
    background="muted"
    eyebrow="Appointment request"
    title="Tell us how to reach you"
    body="Include the office that is most convenient and whether you prefer in-person or virtual."
    services={treatmentServices}
    servicesLabel="Treatment"
    servicesPlaceholder="Select a treatment"
    hearAbout={hearAbout}
  />

  <FAQ eyebrow="FAQ" title="Questions about your consultation" items={faqs} schema={false} />
</BaseLayout>
