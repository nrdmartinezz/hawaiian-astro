---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/blocks/Hero.astro';
import ServicesGrid from '../../components/blocks/ServicesGrid.astro';
import CTABanner from '../../components/blocks/CTABanner.astro';
import { patientFormActions, patientForms } from '../../config/patientForms';
---

<BaseLayout
  title="Patients"
  description="First-visit tips, registration forms, and referral information for Hawaiian Smiles Orthodontics patients."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Patients', href: '/patients/' },
  ]}
>
  <Hero
    eyebrow="Patients"
    title="Everything you need before you walk in"
    body="New patient forms, what to expect at your first visit, and how to refer a friend or colleague."
    actions={[
      { label: 'Request an appointment', href: '/appointment/' },
      ...patientFormActions('secondary'),
    ]}
  />

  <ServicesGrid
    columns={3}
    items={[
      {
        icon: 'lucide:calendar-check',
        title: 'Your First Visit',
        body: 'What happens at a complimentary consultation.',
        href: '/patients/first-visit/',
      },
      {
        icon: 'lucide:clipboard-pen',
        title: 'Registration Forms',
        body: 'Adult and child forms — complete them before you arrive.',
        href: '/patients/forms/',
      },
      ...patientForms.map((form) => ({
        icon: 'lucide:file-text',
        title: form.title,
        body: form.body,
        href: form.href,
        download: form.download,
      })),
      {
        icon: 'lucide:heart-handshake',
        title: 'Referrals',
        body: 'Refer a patient or a neighbor. We will take good care of them.',
        href: '/patients/referrals/',
      },
      {
        icon: 'lucide:newspaper',
        title: 'Blog',
        body: 'Guides on braces, Invisalign, early treatment, and retainers.',
        href: '/blog/',
      },
    ]}
  />

  <CTABanner
    title="New here?"
    body="Request a consult, or download a new-patient form and email it before you arrive."
    actions={[
      { label: 'Request an appointment', href: '/appointment/' },
      ...patientFormActions('outline'),
    ]}
  />
</BaseLayout>
