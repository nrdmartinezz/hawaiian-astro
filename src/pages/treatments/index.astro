---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/blocks/Hero.astro';
import ServicesGrid from '../../components/blocks/ServicesGrid.astro';
import CTABanner from '../../components/blocks/CTABanner.astro';
import FAQ from '../../components/blocks/FAQ.astro';
import { treatments } from '../../config/treatments';
import { treatmentImages } from '../../config/treatmentImages';
import { getFaqsFor } from '../../lib/faqs';

const faqs = await getFaqsFor('/treatments/');

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Treatments', href: '/treatments/' },
];
---

<BaseLayout
  title="Treatments"
  description="Early treatment, adult treatment, airway development, Invisalign, self-ligating braces, retainers, emergency care, and teeth whitening at Hawaiian Smiles."
  breadcrumbs={breadcrumbs}
  faqs={faqs}
>
  <Hero
    eyebrow="Treatments"
    title="Choose the right treatment for you and your keiki"
    body="From age 12 to 62, we offer care that fits your life and budget — metal braces, self-ligating brackets, Invisalign, and everything in between."
    actions={[{ label: 'Request an appointment', href: '/appointment/' }]}
  />

  <ServicesGrid
    title="Explore your options"
    items={treatments.map((treatment) => ({
      title: treatment.title,
      body: treatment.summary,
      href: `/treatments/${treatment.slug}/`,
      image: treatmentImages[treatment.slug],
    }))}
  />

  <FAQ
    eyebrow="FAQ"
    title="Questions about treatment"
    items={faqs}
    schema={false}
  />

  <CTABanner
    title="Not sure which treatment is right?"
    body="A complimentary consultation will map the options for your smile."
    actions={[{ label: 'Request an appointment', href: '/appointment/' }]}
  />
</BaseLayout>
