---
import type { GetStaticPaths, Page } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/ui/Section.astro';
import Container from '../../components/ui/Container.astro';
import Heading from '../../components/ui/Heading.astro';
import Card from '../../components/ui/Card.astro';
import { getPublished, type Entry } from '../../lib/blog';

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const entries = await getPublished();
  return paginate(entries, { pageSize: 9 });
};

interface Props {
  page: Page<Entry>;
}

const { page } = Astro.props;

const dateFormat = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium' });
---

<BaseLayout
  title="Blog"
  description="Orthodontic guides from Hawaiian Smiles — braces, Invisalign, early treatment, and life after retainers."
  breadcrumbs={[
    { name: 'Home', href: '/' },
    { name: 'Patients', href: '/patients/' },
    { name: 'Blog', href: '/blog/' },
  ]}
>
  <Section background="muted" spacing="md">
    <Container gap="sm">
      <Heading level={1}>Blog</Heading>
      <p class="text-ink-muted max-w-reading text-lg">
        Practical answers for families across Oʻahu and the Big Island.
      </p>
    </Container>
  </Section>

  <Section background="base" spacing="md">
    <Container gap="lg">
      <ul class="grid w-full gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          page.data.map((entry) => (
            <Card as="li" variant="outlined">
              <p class="text-ink-muted text-sm">
                <time datetime={entry.data.publishDate.toISOString()}>
                  {dateFormat.format(entry.data.publishDate)}
                </time>
                {entry.data.category && <span> · {entry.data.category}</span>}
              </p>
              <Heading level={2} size="md">
                <a href={`/blog/${entry.id}/`} class="text-ink-base no-underline hover:underline">
                  {entry.data.title}
                </a>
              </Heading>
              <p class="text-ink-muted">{entry.data.description}</p>
            </Card>
          ))
        }
      </ul>

      {
        (page.url.prev || page.url.next) && (
          <nav class="flex w-full items-center justify-between" aria-label="Pagination">
            {page.url.prev ? (
              <a href={page.url.prev} class="text-ink-brand inline-flex min-h-11 items-center">
                ← Newer
              </a>
            ) : (
              <span />
            )}
            <p class="text-ink-muted text-sm">
              Page {page.currentPage} of {page.lastPage}
            </p>
            {page.url.next ? (
              <a href={page.url.next} class="text-ink-brand inline-flex min-h-11 items-center">
                Older →
              </a>
            ) : (
              <span />
            )}
          </nav>
        )
      }
    </Container>
  </Section>
</BaseLayout>
