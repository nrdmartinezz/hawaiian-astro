---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/blocks/Hero.astro';
import ServicesGrid from '../components/blocks/ServicesGrid.astro';
import ValueGrid from '../components/blocks/ValueGrid.astro';
import FeatureSplit from '../components/blocks/FeatureSplit.astro';
import LogoCloud from '../components/blocks/LogoCloud.astro';
import Stats from '../components/blocks/Stats.astro';
import Testimonials from '../components/blocks/Testimonials.astro';
import FAQ from '../components/blocks/FAQ.astro';
import CTABanner from '../components/blocks/CTABanner.astro';
import { site } from '../config/site';
import { treatments } from '../config/treatments';
import { treatmentImages } from '../config/treatmentImages';
import { locations } from '../config/locations';
import { awardLogos, affiliationLogos } from '../config/credentials';
import heroImage from '../assets/hero.jpg';

const faqs = [
  {
    question: 'What is an orthodontist?',
    answer:
      'An orthodontist is a dentist trained to diagnose, prevent, and treat teeth and jaw irregularities — for children, teens, and adults.',
  },
  {
    question: 'How often will I need to visit?',
    answer:
      'With braces, most patients are seen every four to eight weeks. Invisalign visits are often similar, depending on your plan.',
  },
  {
    question: 'When is the right time to see an orthodontist?',
    answer:
      'The American Association of Orthodontists recommends an evaluation by age 7. Adults are welcome any time — it is never too late for a healthy smile.',
  },
  {
    question: 'How much will treatment cost?',
    answer:
      'Fees depend on the complexity of your case, the appliance you choose, and the length of treatment. We review insurance, HSA/FSA, and interest-free monthly plans at your consultation.',
  },
];
---

<BaseLayout
  titleExact
  title={`${site.name} — ${site.tagline}`}
  description={site.description}
  faqs={faqs}
  overlay
>
  <Hero
    backdrop={heroImage}
    backdropAlt=""
    eyebrow="Kaneohe · Kailua-Kona · Kamuela · Hilo"
    title="Changing Lives, One Smile at a time"
    body="Voted Best Hawaii Dentist 2020–2025. Braces, Invisalign, and early treatment with cutting-edge technology and a whole lot of aloha."
    bullets={[
      'Complimentary in-person or virtual consults',
      'Invisalign Diamond Provider',
      'Text-friendly scheduling at (808) 247-6039',
    ]}
    actions={[
      { label: 'Request an appointment', href: '/appointment/' },
      {
        label: site.business.phone,
        href: `tel:${site.business.phoneHref}`,
        variant: 'ghost',
        icon: 'lucide:phone',
      },
    ]}
  >
    <Fragment slot="title">
      Changing Lives, <em class="not-italic">One Smile</em> at a time.
    </Fragment>
  </Hero>

  <Stats
    background="inverse"
    class="bg-[#002931]!"
    align="center"
    spacing="sm"
    items={[
      { value: '6+', label: 'Years Best Hawaii Dentist' },
      { value: '4', label: 'Locations Across Hawaiʻi' },
      { icon: 'lucide:gem', label: 'Diamond Invisalign Provider' },
      { icon: 'lucide:calendar', label: 'Free In-Person & Virtual Consult' },
    ]}
  />

  <ServicesGrid
    eyebrow="Treatments"
    title="Care for every smile"
    body="Children, teens, and adults — from first visits to retainers."
    items={treatments.slice(0, 6).map((treatment) => ({
      title: treatment.title,
      body: treatment.summary,
      href: `/treatments/${treatment.slug}/`,
      image: treatmentImages[treatment.slug],
    }))}
  />

  <ValueGrid
    eyebrow="Why Hawaiian Smiles"
    title="The Standard of Aloha Care"
    body="We rely on advanced technology and our signature welcoming environment to provide superior treatment options to patients of all ages across four Hawaii locations."
    actions={[
      { label: 'Why choose us', href: '/why-choose-us/' },
      { label: 'Our story', href: '/about/', variant: 'secondary' },
    ]}
    items={[
      {
        icon: 'lucide:trophy',
        title: 'Award-Winning Excellence',
        body: 'Voted Best Hawaii Dentist every year from 2020 through 2025 by Hawaii Magazine readers.',
      },
      {
        icon: 'lucide:gem',
        title: 'Invisalign Diamond Provider',
        body: 'Among the top Invisalign providers in Hawaii — recognized for exceptional patient outcomes.',
      },
      {
        icon: 'lucide:microscope',
        title: 'Cutting-Edge Technology',
        body: 'Pitts 21 self-ligating braces and 3D digital scanning for precise, comfortable treatment.',
      },
      {
        icon: 'lucide:smartphone',
        title: 'Text-Friendly Practice',
        body: `Life gets busy. Text us at ${site.business.phone} and we’ll make scheduling effortless for you.`,
      },
      {
        icon: 'lucide:heart',
        title: 'Aloha Spirit',
        body: 'Our warm, welcoming team treats every patient like family — because that’s the Hawaiian way.',
      },
      {
        icon: 'lucide:video',
        title: 'Virtual Consultations',
        body: 'Start your smile journey from the comfort of home with a free virtual consultation.',
      },
    ]}
  >
    <Fragment slot="title">
      The Standard of <em>Aloha Care</em>
    </Fragment>
  </ValueGrid>

  <FeatureSplit
    eyebrow="Clear Aligner Therapy"
    title="Invisalign® Virtually Invisible. Remarkably Effective."
    image={treatmentImages.invisalign}
    imageAlt="A smiling patient holding a clear Invisalign aligner"
    bullets={[
      'Virtually invisible clear trays',
      'Removable for eating and brushing',
      '3D digital treatment planning',
      'Comfortable — no metal brackets',
      'Shorter treatment time',
    ]}
    actions={[
      { label: 'Learn about Invisalign', href: '/treatments/invisalign/' },
      { label: 'Free consultation', href: '/appointment/', variant: 'secondary' },
    ]}
  >
    <Fragment slot="title">
      <span class="flex flex-col">
        Invisalign®
        <em>Virtually Invisible.</em>
        Remarkably Effective.
      </span>
    </Fragment>
    <Fragment slot="body">
      <p class="text-ink-muted max-w-reading text-[1rem]">
        Invisalign® clear aligners straighten your teeth without wires and brackets. The system
        combines cutting-edge 3D digital technology with decades of orthodontic expertise to deliver
        your ideal smile.
      </p>
      <p class="text-ink-muted max-w-reading text-[1rem]">
        Each custom aligner set gradually moves your teeth with precision — swap trays every 1–2
        weeks and watch your smile transform. As Hawaiʻi’s
        <a href="/about/" class="text-ink-brand font-semibold no-underline hover:underline">
          Invisalign Diamond Provider
        </a>, we bring unmatched expertise to every case.
      </p>
    </Fragment>
  </FeatureSplit>

  <LogoCloud
    background="muted"
    groups={[
      { label: 'Award Recognition', items: awardLogos, size: 'lg', class: 'opacity-50' },
      { label: 'Professional Affiliations', items: affiliationLogos, size: 'md' },
    ]}
  />

  <Testimonials
    eyebrow="Reviews"
    title="What patients say"
    items={[
      {
        quote:
          'Recently got my braces and LET ME TELL YOU HOW AMAZING THESE PEOPLE ARE! Within the first month I noticed a very drastic change.',
        name: 'Hayden Rodriguez',
        rating: 5,
      },
      {
        quote:
          'The staff made them feel welcomed and made getting braces a whole lot easier. Thank you Dr. Nayak and the whole Hawaiian Smiles office.',
        name: 'Sarona Kawaauha',
        rating: 5,
      },
      {
        quote:
          'Very professional and personable staff. So easy to fill and sign forms from my phone. I’m so glad we went with Hawaiian Smiles.',
        name: 'Christina Lokia',
        rating: 5,
      },
    ]}
  />

  <ServicesGrid
    background="muted"
    eyebrow="Offices"
    title="Four locations, one practice"
    body="Call or text (808) 247-6039 for any office."
    columns={4}
    items={locations.map((location) => ({
      icon: 'lucide:map-pin',
      title: location.shortName,
      body: `${location.street}, ${location.locality}`,
      href: `/locations/${location.slug}/`,
    }))}
  />

  <FAQ eyebrow="FAQ" title="Common questions" items={faqs} schema={false} />

  <CTABanner
    title="Ready for your Hawaiian smile?"
    body="Request a complimentary consultation — in person or virtual. We will text you back."
    actions={[
      { label: 'Request an appointment', href: '/appointment/' },
      { label: 'View locations', href: '/locations/', variant: 'inverse' },
    ]}
  />
</BaseLayout>
