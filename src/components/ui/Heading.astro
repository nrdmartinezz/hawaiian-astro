---
import type { HTMLAttributes } from 'astro/types';

export type HeadingLevel = 1 | 2 | 3 | 4 | 5 | 6;
export type HeadingSize = 'sm' | 'md' | 'lg' | 'xl' | '2xl' | 'display';
export type HeadingWeight = 'normal' | 'medium' | 'semibold';

interface Props extends Omit<HTMLAttributes<'h2'>, 'class'> {
  /** Semantic level — set independently of visual size so document outline stays correct. */
  level?: HeadingLevel;
  size?: HeadingSize;
  weight?: HeadingWeight;
  balance?: boolean;
  class?: string;
}

const { level = 2, size, weight = 'semibold', balance = true, class: className, ...rest } =
  Astro.props;

const Tag = `h${level}` as const;

const defaultSizeForLevel: Record<HeadingLevel, HeadingSize> = {
  1: 'display',
  2: 'xl',
  3: 'lg',
  4: 'md',
  5: 'sm',
  6: 'sm',
};

const sizes: Record<HeadingSize, string> = {
  sm: 'text-lg',
  md: 'text-xl',
  lg: 'text-2xl',
  xl: 'text-3xl',
  '2xl': 'text-4xl',
  display: 'text-5xl',
};

const weights: Record<HeadingWeight, string> = {
  normal: 'font-normal',
  medium: 'font-medium',
  semibold: 'font-semibold',
};
---

<Tag
  class:list={[
    'font-heading tracking-normal',
    weights[weight],
    sizes[size ?? defaultSizeForLevel[level]],
    balance && 'text-balance',
    className,
  ]}
  {...rest}
>
  <slot />
</Tag>
