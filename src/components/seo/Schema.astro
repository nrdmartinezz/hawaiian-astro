---
import { locations } from '../../config/locations';
import { site } from '../../config/site';

export interface BreadcrumbEntry {
  name: string;
  href: string;
}

export interface FaqEntry {
  question: string;
  answer: string;
}

export interface PersonEntry {
  name: string;
  jobTitle: string;
  description: string;
  image?: string;
}

export interface ArticleEntry {
  headline: string;
  description?: string;
  datePublished: string;
  dateModified?: string;
  image?: string;
  author?: string;
}

interface Props {
  breadcrumbs?: BreadcrumbEntry[];
  faqs?: FaqEntry[];
  service?: { name: string; description?: string };
  /** Office slug. The page's main entity becomes that office. */
  locationSlug?: string;
  people?: PersonEntry[];
  article?: ArticleEntry;
}

const { breadcrumbs, faqs, service, locationSlug, people, article } = Astro.props;

const businessId = `${site.url}/#business`;
const abs = (path: string) => new URL(path, site.url).href;
const pageUrl = abs(Astro.url.pathname);

const postal = (address: {
  street: string;
  locality: string;
  region: string;
  postalCode: string;
  country?: string;
}) => ({
  '@type': 'PostalAddress',
  streetAddress: address.street,
  addressLocality: address.locality,
  addressRegion: address.region,
  postalCode: address.postalCode,
  addressCountry: address.country ?? 'US',
});

const officeId = (slug: string) => `${site.url}/locations/${slug}/#office`;

const offices = locations.map((location) => ({
  '@type': 'Dentist',
  '@id': officeId(location.slug),
  name: `Hawaiian Smiles Orthodontics — ${location.shortName}`,
  url: abs(`/locations/${location.slug}/`),
  telephone: site.business.phone,
  parentOrganization: { '@id': businessId },
  address: postal({
    street: location.street,
    locality: location.locality,
    region: location.region,
    postalCode: location.postalCode,
  }),
  ...(location.slug === 'kaneohe' && site.business.geo
    ? {
        geo: {
          '@type': 'GeoCoordinates',
          latitude: site.business.geo.latitude,
          longitude: site.business.geo.longitude,
        },
      }
    : {}),
  openingHours: site.business.hours,
}));

const graph: Record<string, unknown>[] = [
  {
    '@type': site.business.schemaType,
    '@id': businessId,
    name: site.name,
    legalName: site.legalName,
    description: site.description,
    url: site.url,
    logo: abs('/apple-touch-icon.png'),
    image: abs(site.defaultOgImage),
    telephone: site.business.phone,
    email: site.business.email,
    ...(site.business.fax && { faxNumber: site.business.fax }),
    priceRange: site.business.priceRange,
    address: postal(site.business.address),
    ...(site.business.geo && {
      geo: {
        '@type': 'GeoCoordinates',
        latitude: site.business.geo.latitude,
        longitude: site.business.geo.longitude,
      },
    }),
    openingHours: site.business.hours,
    areaServed: {
      '@type': 'AdministrativeArea',
      name: 'Hawaii',
    },
    sameAs: Object.values(site.social).filter(Boolean),
    location: offices.map((office) => ({ '@id': office['@id'] })),
  },
  ...offices,
  {
    '@type': 'WebSite',
    '@id': `${site.url}/#website`,
    url: site.url,
    name: site.name,
    description: site.description,
    publisher: { '@id': businessId },
    inLanguage: site.locale,
  },
];

if (locationSlug) {
  graph.push({
    '@type': 'WebPage',
    '@id': `${pageUrl}#webpage`,
    url: pageUrl,
    name: locations.find((location) => location.slug === locationSlug)?.name,
    isPartOf: { '@id': `${site.url}/#website` },
    about: { '@id': businessId },
    mainEntity: { '@id': officeId(locationSlug) },
    inLanguage: site.locale,
  });
}

if (breadcrumbs?.length) {
  graph.push({
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((crumb, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: crumb.name,
      item: abs(crumb.href),
    })),
  });
}

if (faqs?.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqs.map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: { '@type': 'Answer', text: faq.answer },
    })),
  });
}

if (service) {
  graph.push({
    '@type': 'Service',
    name: service.name,
    description: service.description,
    provider: { '@id': businessId },
    areaServed: 'Hawaii',
  });
}

if (people?.length) {
  for (const person of people) {
    graph.push({
      '@type': 'Person',
      name: person.name,
      jobTitle: person.jobTitle,
      description: person.description,
      ...(person.image && { image: abs(person.image) }),
      worksFor: { '@id': businessId },
    });
  }
}

if (article) {
  graph.push({
    '@type': 'BlogPosting',
    headline: article.headline,
    description: article.description,
    datePublished: article.datePublished,
    ...(article.dateModified && { dateModified: article.dateModified }),
    ...(article.image && { image: abs(article.image) }),
    author: article.author ? { '@type': 'Person', name: article.author } : { '@id': businessId },
    publisher: { '@id': businessId },
    mainEntityOfPage: pageUrl,
    inLanguage: site.locale,
  });
}

const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
