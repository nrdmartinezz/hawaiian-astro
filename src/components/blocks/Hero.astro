---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

interface Props extends Omit<BlockProps, 'titleLevel'> {
  title: string;
  actions?: BlockAction[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** Full-bleed photo behind a light-to-dark teal overlay (180deg). */
  backdrop?: ImageMetadata;
  backdropAlt?: string;
  /**
   * Pull the band up under a transparent header. Off when the hero is not
   * the first band on the page.
   */
  bleed?: boolean;
  /** Places the image first on desktop; small screens always stack image-first. */
  reverse?: boolean;
  bullets?: string[];
}

const {
  spacing = 'lg',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  actions = [],
  image,
  imageAlt = '',
  backdrop,
  backdropAlt = '',
  bleed = true,
  reverse = false,
  bullets = [],
} = Astro.props;

const photoHero = Boolean(backdrop);
const split = Boolean(image) && !photoHero;

const actionVariant = (variant: BlockAction['variant']): BlockAction['variant'] =>
  variant === 'secondary' ? 'outline' : variant;
---

<Section
  background="inverse"
  spacing={bleed ? 'none' : spacing}
  clip={photoHero}
  class={bleed
    ? 'relative -mt-[var(--header-h,5rem)] pt-[calc(var(--spacing-section-lg)+var(--header-h,5rem))] pb-section-lg'
    : undefined}
>
  {
    backdrop && (
      <>
        <Image
          src={backdrop}
          alt={backdropAlt}
          widths={[768, 1024, 1600, 2400]}
          sizes="100vw"
          quality={90}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 size-full object-cover object-center"
        />
        <div
          class="from-accent-600/60 absolute inset-0 bg-linear-to-b to-neutral-950"
          aria-hidden="true"
        />
      </>
    )
  }

  <Container
    width={width}
    layout={split ? 'row' : 'stack'}
    align={align}
    gap="lg"
    class={photoHero ? 'relative' : undefined}
  >
    <div
      class:list={['flex flex-col items-start gap-6', split && 'md:w-1/2', reverse && 'md:order-2']}
    >
      {
        eyebrow && (
          <p class="text-ink-inverse/80 text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>
        )
      }

      <Heading level={1}>
        <slot name="title">{title}</slot>
      </Heading>

      {body && <p class="max-w-reading text-lg text-white/75">{body}</p>}

      {
        bullets.length > 0 && (
          <ul class="flex flex-col gap-2">
            {bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <Icon
                  name="lucide:circle-check"
                  class="text-brand-500 mt-1 size-5 shrink-0"
                  aria-hidden="true"
                />
                <span class="text-white/50">{bullet}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        actions.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {actions.map((action) => (
              <Button
                href={action.href}
                download={action.download}
                variant={actionVariant(action.variant)}
                size="lg"
              >
                {action.icon && <Icon name={action.icon} class="size-5" aria-hidden="true" />}
                {action.label}
              </Button>
            ))}
          </div>
        )
      }
    </div>

    {
      split && image && (
        <div class:list={['w-full md:w-1/2', reverse && 'md:order-1']}>
          <Image
            src={image}
            alt={imageAlt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, 50vw"
            loading="eager"
            fetchpriority="high"
            class="w-full rounded-lg object-cover"
          />
        </div>
      )
    }
  </Container>
</Section>
