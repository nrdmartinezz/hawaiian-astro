---
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import { locationAddress, type PracticeLocation } from '../../config/locations';
import { site } from '../../config/site';
import type { BlockProps } from './types';

interface Props extends BlockProps {
  items: PracticeLocation[];
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow,
  title,
  titleLevel = 2,
  items,
} = Astro.props;

const headingLevel = titleLevel === 2 ? 3 : 4;
const hours = 'Mon – Fri: 8:00 AM – 5:00 PM';
---

<Section background={background} spacing={spacing}>
  <Container width={width} gap="lg">
    {
      (eyebrow || title || Astro.slots.has('title')) && (
        <div class="flex w-full flex-col gap-3">
          {eyebrow && (
            <p class="text-brand-500 text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>
          )}
          <Heading level={titleLevel} size="2xl" weight="normal">
            <slot name="title">{title}</slot>
          </Heading>
        </div>
      )
    }

    <ul class="grid w-full grid-cols-4 gap-6 max-lg:grid-cols-2 max-md:grid-cols-1">
      {
        items.map((location) => (
          <li class="border-line-base flex flex-col border border-t-4 border-t-accent-600 bg-surface-base p-6 shadow-sm">
            <Heading level={headingLevel} size="md" weight="normal">
              {location.shortName}
            </Heading>
            <p class="text-brand-500 mt-1 text-xs font-semibold tracking-wide uppercase">
              {location.island}
            </p>

            <ul class="mt-5 flex flex-col gap-3">
              <li class="text-ink-muted flex items-start gap-3 text-sm">
                <Icon
                  name="lucide:map-pin"
                  class="text-accent-600 mt-0.5 size-4 shrink-0"
                  aria-hidden="true"
                />
                <span>{locationAddress(location)}</span>
              </li>
              <li class="text-ink-muted flex items-start gap-3 text-sm">
                <Icon
                  name="lucide:phone"
                  class="text-brand-500 mt-0.5 size-4 shrink-0"
                  aria-hidden="true"
                />
                <a
                  href={`tel:${site.business.phoneHref}`}
                  class="text-ink-muted no-underline hover:underline"
                >
                  {site.business.phone}
                </a>
              </li>
              <li class="text-ink-muted flex items-start gap-3 text-sm">
                <Icon
                  name="lucide:clock"
                  class="text-accent-600 mt-0.5 size-4 shrink-0"
                  aria-hidden="true"
                />
                <span>{hours}</span>
              </li>
            </ul>

            <div class="mt-auto pt-6">
              <Button
                href={location.mapsUrl}
                variant="accent"
                size="sm"
                class="w-full"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="lucide:map" class="size-4" aria-hidden="true" />
                Get directions
              </Button>
            </div>
          </li>
        ))
      }
    </ul>
  </Container>
</Section>
