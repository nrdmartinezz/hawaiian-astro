---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

interface Props extends BlockProps {
  image?: ImageMetadata;
  imageAlt?: string;
  bullets?: string[];
  actions?: BlockAction[];
  /** Image right on desktop by default; small screens always stack image-first. */
  reverse?: boolean;
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  image,
  imageAlt = '',
  bullets = [],
  actions = [],
  reverse = false,
} = Astro.props;
---

<Section background={background} spacing={spacing}>
  <Container width={width} gap="lg">
    <div class="flex w-full flex-col gap-12 md:flex-row md:items-stretch md:gap-16">
      <div class:list={['w-full md:w-1/2', reverse ? 'md:order-2' : 'md:order-1']}>
        {
          image ? (
            <Image
              src={image}
              alt={imageAlt}
              widths={[480, 768, 1024]}
              sizes="(max-width: 768px) 100vw, 50vw"
              loading="lazy"
              class="h-full min-h-72 w-full rounded-lg object-cover"
            />
          ) : (
            <div class="bg-surface-muted min-h-72 h-full w-full rounded-lg" aria-hidden="true" />
          )
        }
      </div>

      <div
        class:list={[
          'flex flex-col items-start gap-5 md:w-1/2',
          reverse ? 'md:order-1' : 'md:order-2',
        ]}
      >
        {
          eyebrow && (
            <p class="text-brand-500 text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>
          )
        }

        <Heading level={titleLevel} size="2xl" weight="normal">
          <slot name="title">{title}</slot>
        </Heading>

        <span class="bg-brand-500 h-1 w-16" aria-hidden="true"></span>

        <slot name="body">
          {body && <p class="text-ink-muted max-w-reading text-[1rem]">{body}</p>}
        </slot>

        {
          bullets.length > 0 && (
            <ul class="flex flex-col gap-2">
              {bullets.map((bullet) => (
                <li class="text-ink-muted flex items-start gap-3">
                  <span
                    class="bg-brand-500 mt-2 size-1.5 shrink-0 rounded-full"
                    aria-hidden="true"
                  />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )
        }

        {
          actions.length > 0 && (
            <div class="flex flex-wrap gap-3">
              {actions.map((action) => (
                <Button href={action.href} variant={action.variant ?? 'primary'}>
                  {action.icon && <Icon name={action.icon} class="size-4" aria-hidden="true" />}
                  {action.label}
                </Button>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </Container>
</Section>
