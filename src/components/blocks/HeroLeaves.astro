---
import { Image } from 'astro:assets';
import leaves from '../../assets/subpage-hero.png';
import leavesMobile from '../../assets/subpage-hero-mobile.png';

const imageClass =
  'pointer-events-none absolute inset-0 size-full object-center mix-blend-lighten';
---

<div class="pointer-events-none absolute inset-0 isolate bg-[#074754]" aria-hidden="true">
  <Image
    src={leavesMobile}
    alt=""
    widths={[480, 768, 1024]}
    sizes="100vw"
    quality={90}
    loading="eager"
    class:list={[imageClass, 'object-contain md:hidden']}
  />
  <Image
    src={leaves}
    alt=""
    widths={[640, 1024]}
    sizes="100vw"
    quality={90}
    loading="eager"
    class:list={[imageClass, 'hidden object-cover md:block']}
  />
</div>
