---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import type { BlockProps, BlockAction } from './types';

interface Props extends BlockProps {
  actions: BlockAction[];
  backdrop?: ImageMetadata;
  backdropAlt?: string;
}

const {
  background = 'brand',
  spacing = 'md',
  align = 'center',
  width = 'narrow',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  actions,
  backdrop,
  backdropAlt = '',
} = Astro.props;

const photo = Boolean(backdrop);
const defaultVariant = photo
  ? 'primary'
  : background === 'brand' || background === 'inverse'
    ? 'inverse'
    : 'primary';
---

<Section
  background={photo ? 'inverse' : background}
  spacing={photo ? 'lg' : spacing}
  clip={photo}
  class={photo ? 'relative' : undefined}
>
  {
    backdrop && (
      <>
        <Image
          src={backdrop}
          alt={backdropAlt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          loading="lazy"
          class="absolute inset-0 size-full object-cover"
        />
        <div
          class="from-accent-600/70 absolute inset-0 bg-linear-to-b to-neutral-950/80"
          aria-hidden="true"
        />
      </>
    )
  }

  <Container
    width={width}
    align={align}
    gap="md"
    class={photo ? 'relative' : undefined}
  >
    {
      eyebrow && (
        <p
          class:list={[
            'text-sm font-semibold tracking-wide uppercase',
            photo ? 'text-ink-inverse' : 'opacity-80',
          ]}
        >
          {eyebrow}
        </p>
      )
    }

    <Heading level={titleLevel} size={photo ? '2xl' : undefined} weight="normal">
      <slot name="title">{title}</slot>
    </Heading>

    {photo && <span class="bg-brand-500 h-px w-16" aria-hidden="true" />}

    {body && <p class:list={['max-w-reading text-lg', photo ? 'text-white/75' : 'opacity-90']}>{body}</p>}

    <div class:list={['flex flex-wrap gap-3', align === 'center' && 'justify-center']}>
      {
        actions.map((action) => (
          <Button href={action.href} variant={action.variant ?? defaultVariant} size="lg">
            {action.label}
          </Button>
        ))
      }
    </div>
  </Container>
</Section>
