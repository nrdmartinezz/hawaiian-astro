---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Card from '../ui/Card.astro';
import Heading from '../ui/Heading.astro';
import BlockHeader from './BlockHeader.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps } from './types';

export interface ServiceItem {
  title: string;
  body: string;
  href?: string;
  icon?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  cta?: string;
}

interface Props extends BlockProps {
  items: ServiceItem[];
  columns?: 2 | 3 | 4;
}

const {
  background = 'base',
  spacing = 'md',
  align = 'start',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  items,
  columns = 3,
} = Astro.props;

const photoStrip = items.length > 0 && items.every((item) => Boolean(item.image));

// Owns its own grid rather than asking Container to model it.
const columnClass = {
  2: 'sm:grid-cols-2',
  3: 'sm:grid-cols-2 lg:grid-cols-3',
  4: 'sm:grid-cols-2 lg:grid-cols-4',
}[columns];

const headingLevel = titleLevel === 2 ? 3 : 4;
---

<Section background={background} spacing={spacing}>
  <Container width={width} align={align} gap="lg">
    <BlockHeader
      eyebrow={eyebrow}
      title={title}
      body={body}
      level={titleLevel}
      centered={align === 'center'}
      split={align !== 'center'}
    />

    <ul
      class:list={[
        'w-full',
        photoStrip ? 'flex flex-row max-lg:flex-wrap' : ['grid gap-6', columnClass],
      ]}
    >
      {
        items.map((item) => {
          if (photoStrip && item.image) {
            const Tag = item.href ? 'a' : 'div';
            return (
              <li class="min-h-96 min-w-0 max-lg:basis-1/3 max-md:basis-full lg:flex-1">
                <Tag
                  href={item.href}
                  class:list={[
                    'text-ink-inverse relative flex h-full min-h-96 flex-col overflow-hidden no-underline',
                    item.href && 'group',
                  ]}
                >
                  <Image
                    src={item.image}
                    alt={item.imageAlt ?? ''}
                    widths={[320, 480, 768]}
                    sizes="(max-width: 768px) 100vw, (max-width: 1024px) 33vw, 17vw"
                    class="absolute inset-0 size-full object-cover"
                  />
                  <div
                    class:list={[
                      'from-accent-600/60 absolute inset-0 bg-linear-to-b to-neutral-950 transition-opacity duration-150',
                      item.href &&
                        'opacity-70 group-hover:opacity-100 group-focus-visible:opacity-100',
                    ]}
                    aria-hidden="true"
                  />
                  <div class="relative mt-auto flex flex-col items-start gap-3 p-6">
                    <Heading level={headingLevel} size="sm">
                      {item.title}
                    </Heading>
                    <p class="text-ink-inverse/90">{item.body}</p>
                    {item.href && (
                      <span class="text-ink-inverse/50 group-hover:text-brand-500 group-focus-visible:text-brand-500 mt-1 text-sm font-medium tracking-wide uppercase transition-colors duration-150">
                        {item.cta ?? 'Learn more'}
                      </span>
                    )}
                  </div>
                </Tag>
              </li>
            );
          }

          return (
            <Card as="li" variant="outlined">
              {item.icon && (
                <Icon name={item.icon} class="text-brand-600 size-8" aria-hidden="true" />
              )}
              <Heading level={headingLevel} size="md">
                {item.href ? (
                  <a href={item.href} class="text-ink-base no-underline hover:underline">
                    {item.title}
                  </a>
                ) : (
                  item.title
                )}
              </Heading>
              <p class="text-ink-muted">{item.body}</p>
            </Card>
          );
        })
      }
    </ul>
  </Container>
</Section>
