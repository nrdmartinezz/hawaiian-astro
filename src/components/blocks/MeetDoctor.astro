---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Section from '../ui/Section.astro';
import Container from '../ui/Container.astro';
import Heading from '../ui/Heading.astro';
import Button from '../ui/Button.astro';
import { Icon } from 'astro-icon/components';
import type { BlockProps, BlockAction } from './types';

interface Props extends BlockProps {
  image?: ImageMetadata;
  imageAlt?: string;
  name: string;
  credentials?: string;
  actions?: BlockAction[];
}

const {
  background = 'base',
  spacing = 'md',
  width = 'page',
  eyebrow,
  title,
  body,
  titleLevel = 2,
  image,
  imageAlt = '',
  name,
  credentials,
  actions = [],
} = Astro.props;
---

<Section background={background} spacing={spacing} clip id="meet-the-doctor">
  <Container width={width} gap="lg">
    <div class="flex w-full flex-col gap-12 md:flex-row md:items-center md:gap-16">
      <div class="relative w-full md:w-1/2">
        <div
          class="bg-accent-400/15 absolute -top-10 -left-12 size-56 rounded-full max-md:size-40"
          aria-hidden="true"
        >
        </div>
        <div
          class="bg-accent-500/10 absolute -top-20 left-24 size-72 rounded-full max-md:-top-8 max-md:left-16 max-md:size-48"
          aria-hidden="true"
        >
        </div>

        <figure class="relative">
          {
            image ? (
              <Image
                src={image}
                alt={imageAlt}
                widths={[480, 768, 1024]}
                sizes="(max-width: 768px) 100vw, 50vw"
                loading="lazy"
                class="aspect-square w-full rounded-lg object-cover object-[center_30%] max-md:aspect-4/3"
              />
            ) : (
              <div
                class="bg-surface-muted aspect-square w-full rounded-lg max-md:aspect-4/3"
                aria-hidden="true"
              />
            )
          }
          <figcaption
            class="bg-surface-inverse text-ink-inverse absolute inset-x-0 bottom-0 rounded-b-lg px-6 py-4"
          >
            <p class="font-heading text-xl">{name}</p>
            {
              credentials && (
                <p class="mt-0.5 text-xs font-medium tracking-wide uppercase opacity-80">
                  {credentials}
                </p>
              )
            }
          </figcaption>
        </figure>
      </div>

      <div class="flex flex-col items-start gap-5 md:w-1/2">
        {
          eyebrow && (
            <p class="text-brand-500 text-sm font-semibold tracking-wide uppercase">{eyebrow}</p>
          )
        }

        <Heading level={titleLevel} size="xl" weight="normal">
          <slot name="title">{title}</slot>
        </Heading>

        <div class="flex flex-col gap-4">
          <slot name="body">
            {body && <p class="text-ink-muted max-w-reading text-[1rem]">{body}</p>}
          </slot>
        </div>

        {
          actions.length > 0 && (
            <div class="flex flex-wrap gap-3">
              {actions.map((action) => (
                <Button href={action.href} variant={action.variant ?? 'primary'}>
                  {action.icon && <Icon name={action.icon} class="size-4" aria-hidden="true" />}
                  {action.label}
                </Button>
              ))}
            </div>
          )
        }
      </div>
    </div>
  </Container>
</Section>
