---
import { site } from '../../config/site';
import logoMark from '../../assets/logo.svg?url';
import logoWordmark from '../../assets/logo-white.svg?url';

interface Props {
  variant?: 'mark' | 'wordmark';
  class?: string;
}

const { variant = 'mark', class: className } = Astro.props;
---

{
  variant === 'wordmark' ? (
    <img src={logoWordmark} alt={site.name} width="200" height="125" class:list={['h-16 w-auto', className]} />
  ) : (
    <span class:list={['flex items-center gap-2', className]}>
      <img src={logoMark} alt="" width="60" height="60" class="size-10" />
      <span class="flex flex-col leading-tight">
        <span class="font-heading font-semibold">Hawaiian Smiles</span>
        <span class="text-ink-muted text-xs font-medium tracking-wide uppercase">Orthodontics</span>
      </span>
    </span>
  )
}
