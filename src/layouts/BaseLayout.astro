---
import '../styles/global.css';

import SEO from '../components/seo/SEO.astro';
import Schema, {
  type ArticleEntry,
  type BreadcrumbEntry,
  type FaqEntry,
  type PersonEntry,
} from '../components/seo/Schema.astro';
import Analytics from '../components/analytics/Analytics.astro';
import CookieConsent from '../components/analytics/CookieConsent.astro';
import Header, { type HeaderSticky } from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import RecaptchaV3 from '../components/forms/RecaptchaV3.astro';
import SiteFormHandler from '../components/forms/SiteFormHandler.astro';
import { allowIndexing, hasAnalytics, site } from '../config/site';

interface Props {
  title?: string;
  description?: string;
  titleExact?: boolean;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbs?: BreadcrumbEntry[];
  faqs?: FaqEntry[];
  service?: { name: string; description?: string };
  locationSlug?: string;
  people?: PersonEntry[];
  article?: ArticleEntry;
  sticky?: HeaderSticky;
  /** Float the header over the inverse hero until the page is scrolled. */
  overlay?: boolean;
}

const {
  breadcrumbs,
  faqs,
  service,
  locationSlug,
  people,
  article,
  sticky = 'sticky',
  overlay = true,
  ...seo
} = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#49206e" />
    {allowIndexing && <link rel="sitemap" href="/sitemap-index.xml" />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} Blog`} href="/rss.xml" />
    <link rel="preconnect" href="https://use.typekit.net" crossorigin />
    <link rel="preconnect" href="https://p.typekit.net" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/xzq1vrf.css" />
    <meta name="generator" content={Astro.generator} />

    <!-- Switches the nav from its CSS-only fallback to scripted control. Inline
         and early so the mega panel never flashes open during load. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <SEO {...seo} />
    <Schema
      breadcrumbs={breadcrumbs}
      faqs={faqs}
      service={service}
      locationSlug={locationSlug}
      people={people}
      article={article}
    />
    {hasAnalytics && allowIndexing && <Analytics />}

    <slot name="head" />
  </head>

  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="focus:bg-surface-base sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-100 focus:rounded-md focus:px-4 focus:py-2 focus:shadow-md"
    >
      Skip to content
    </a>

    <Header sticky={sticky} overlay={overlay} />

    <main id="main" class="flex-1">
      <slot />
    </main>

    <Footer />
    <RecaptchaV3 />
    <SiteFormHandler />
    {site.consent === 'banner' && <CookieConsent />}
  </body>
</html>
