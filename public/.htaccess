  RewriteRule ^invisalign-first/?$ /treatments/invisalign/children/ [R=301,L]
  RewriteRule ^meet-the-doctors/?$ /about/doctors/ [R=301,L]
  RewriteRule ^your-first-visit/?$ /patients/first-visit/ [R=301,L]
  RewriteRule ^sitemap_index\.xml$ /sitemap-index.xml [R=301,L]
  RewriteRule ^adult-treatment/?$ /treatments/adult-treatment/ [R=301,L]
  RewriteRule ^early-treatment/?$ /treatments/early-treatment/ [R=301,L]
  RewriteRule ^teeth-whitening/?$ /treatments/teeth-whitening/ [R=301,L]
