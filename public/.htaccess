# ---------------------------------------------------------------------------
# Astro static build on cPanel / Apache.
# Assumes astro.config.mjs: trailingSlash 'always' + build.format 'directory'.
# ---------------------------------------------------------------------------

Options -Indexes
DirectoryIndex index.html

# Astro emits the 404 as a flat /404.html even with build.format 'directory'.
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force HTTPS.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Force non-www. Swap the two lines below to prefer www instead.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # Legacy WordPress URLs. Longer paths first so nested rules win.
  RewriteRule ^treatments/retention/?$ /treatments/retainers/ [R=301,L]
  RewriteRule ^early-orthodontic-treatment-and-airway-development/?$ /treatments/airway/ [R=301,L]
  RewriteRule ^orthodontist-in-kailua-kona-hawaii/?$ /locations/kailua-kona/ [R=301,L]
  RewriteRule ^orthodontist-in-kaneohe/braces/?$ /treatments/braces/ [R=301,L]
  RewriteRule ^orthodontist-in-kamuela-hawaii/?$ /locations/kamuela/ [R=301,L]
  RewriteRule ^orthodontist-in-hilo-hawaii/?$ /locations/hilo/ [R=301,L]
  RewriteRule ^orthodontic-clearance-form/?$ /patients/forms/ [R=301,L]
  RewriteRule ^orthodontist-in-kaneohe/?$ /locations/kaneohe/ [R=301,L]
  RewriteRule ^self-ligating-brackets/?$ /treatments/braces/ [R=301,L]
  RewriteRule ^financial-information/?$ /about/financial/ [R=301,L]
  RewriteRule ^virtual-consultation/?$ /appointment/ [R=301,L]
  RewriteRule ^appointment-request/?$ /appointment/ [R=301,L]
  RewriteRule ^registration-forms/?$ /patients/forms/ [R=301,L]
